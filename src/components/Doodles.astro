---
// Scatters the drawings in public/doodles/ across the page background.
// Drop in black-on-transparent PNG or SVG files; they get inked in the two palette colors.
// Files named placeholder-* are only used until you add your own.
import fs from 'node:fs';
import path from 'node:path';
import { BUILD_TIME } from '../lib/build';

interface Props {
  count?: number;
}
const { count = 14 } = Astro.props;

const BUILD_SEED: string = import.meta.env.DOODLE_SEED || BUILD_TIME;

// Horizontal band for doodle centers, as % of page width in from each edge.
// Raise both numbers to pull doodles toward the middle.
const EDGE: [number, number] = [5, 13];

// Doodle size range in px (desktop). Mobile shows them at 45% of this.
const SIZE: [number, number] = [180, 390];

// Share of doodles inked in the second palette color (ink-b)
const TEAL_SHARE = 0.65;

let files: string[] = [];
try {
  files = fs
    .readdirSync(path.join(process.cwd(), 'public', 'doodles'))
    .filter((f) => /\.(svg|png|webp)$/i.test(f))
    .sort();
} catch {
  files = [];
}
const own = files.filter((f) => !f.startsWith('placeholder-'));
const pool = own.length > 0 ? own : files;

// Seeded by build + page path: every deploy gets a fresh layout (which doodles,
// where, and which ink), each page differs, and reloads don't reshuffle.
// To lock a layout you like, set DOODLE_SEED (any text) in the build environment.
function hash(s: string) {
  let h = 2166136261;
  for (const c of s) h = Math.imul(h ^ c.charCodeAt(0), 16777619);
  return h >>> 0;
}
function rng(seed: number) {
  return () => {
    seed = (seed + 0x6d2b79f5) >>> 0;
    let t = seed;
    t = Math.imul(t ^ (t >>> 15), t | 1);
    t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
const rand = rng(hash(`${BUILD_SEED}:${Astro.url.pathname}`));
const between = (a: number, b: number) => a + rand() * (b - a);

// Never repeat a doodle next to itself: skip the previous one, and also the one
// before it (the nearest doodle on the same side), when there are enough to choose from.
const picks: string[] = [];
function pickFile(): string {
  const keep = Math.min(2, pool.length - 1); // with a single doodle, repeats are unavoidable
  const avoid = keep > 0 ? picks.slice(-keep) : [];
  const options = pool.filter((f) => !avoid.includes(f));
  const file = options[Math.floor(rand() * options.length)];
  picks.push(file);
  return file;
}

const items = pool.length === 0 ? [] : Array.from({ length: count }, (_, i) => {
  const left = i % 2 === 0; // alternate margins
  return {
    file: pickFile(),
    top: Math.min(98, ((i + 0.5) / count) * 100 + between(-3, 3)),
    x: left ? between(EDGE[0], EDGE[1]) : 100 - between(EDGE[0], EDGE[1]),
    size: Math.round(between(SIZE[0], SIZE[1])),
    rotate: Math.round(between(-30, 30)),
    ink: rand() < TEAL_SHARE ? 'var(--ink-b)' : 'var(--ink-a)',
    mobile: i % 3 === 0, // only every third doodle shows on small screens
  };
});
---
{items.length > 0 && (
  <div class="doodles" aria-hidden="true">
    {items.map((d) => (
      <span
        class:list={['doodle', { 'hide-mobile': !d.mobile }]}
        style={`top:${d.top.toFixed(2)}%;left:${d.x.toFixed(2)}%;--size:${d.size}px;--rot:${d.rotate}deg;--ink:${d.ink};--src:url('/doodles/${d.file}')`}
      ></span>
    ))}
  </div>
)}

<style>
  .doodles {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }
  .doodle {
    position: absolute;
    width: var(--size);
    height: var(--size);
    background: var(--ink);
    -webkit-mask: var(--src) center / contain no-repeat;
    mask: var(--src) center / contain no-repeat;
    transform: translate(-50%, -50%) rotate(var(--rot));
    mix-blend-mode: multiply;
    opacity: 0.9;
  }
  @media (max-width: 720px) {
    .doodle { opacity: 0.35; width: calc(var(--size) * 0.45); height: calc(var(--size) * 0.45); }
    .hide-mobile { display: none; }
  }
</style>

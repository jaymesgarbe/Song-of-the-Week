---
import { render } from 'astro:content';
import {
  type Week,
  artistLabel,
  formatScore,
  timestampToSeconds,
} from '../lib/weeks';

interface Props {
  entry: Week;
  headingLevel?: 'h1' | 'h2';
}
const { entry, headingLevel = 'h1' } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const hasReview = Boolean(entry.body?.trim());
const Heading = headingLevel;

const dateLabel = d.date
  ? d.date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' })
  : null;

const startSeconds = d.favorite ? timestampToSeconds(d.favorite.timestamp) : 0;
const embedSrc = d.favorite?.youtubeId
  ? `https://www.youtube-nocookie.com/embed/${d.favorite.youtubeId}?start=${startSeconds}`
  : null;

const linkLabels: Record<string, string> = {
  spotify: 'Spotify',
  apple: 'Apple Music',
  youtube: 'YouTube',
  bandcamp: 'Bandcamp',
};
const links = Object.entries(d.links ?? {}).filter(([, url]) => url);
---
<article class="song">
  <p class="song-meta muted">
    Week {d.week}{dateLabel && <>, <time datetime={d.date!.toISOString().slice(0, 10)}>{dateLabel}</time></>}
  </p>

  <div class="song-top">
    {d.cover && (
      <img class="song-cover" src={d.cover} alt={`Cover art for ${d.title}`} width="600" height="600" />
    )}
    <div class="song-id">
      <Heading class="song-title">{d.title}</Heading>
      <p class="song-artist">
        {artistLabel(entry)}
        {d.album && <span class="muted">, {d.album}{d.year && ` (${d.year})`}</span>}
      </p>

      <p class="song-score" aria-label={`Score: ${formatScore(d.score)} out of 10`}>
        <span class="score-value">{formatScore(d.score)}</span><span class="score-max">/10</span>
      </p>

      {links.length > 0 && (
        <ul class="song-links" aria-label="Listen">
          {links.map(([key, url]) => (
            <li><a href={url} rel="noopener" target="_blank">{linkLabels[key] ?? key}</a></li>
          ))}
        </ul>
      )}
    </div>
  </div>

  {d.favorite && (
    <section class="favorite" aria-labelledby={`fav-${d.week}`}>
      <h3 id={`fav-${d.week}`}>Favorite part: {d.favorite.timestamp}</h3>
      {d.favorite.note && <p>{d.favorite.note}</p>}
      {embedSrc && (
        <div class="embed">
          <iframe
            src={embedSrc}
            title={`${d.title} by ${artistLabel(entry)}, starting at ${d.favorite.timestamp}`}
            loading="lazy"
            allow="encrypted-media; picture-in-picture"
            allowfullscreen
          ></iframe>
        </div>
      )}
    </section>
  )}

  {hasReview && (
    <div class="review">
      <Content />
    </div>
  )}
</article>

<style>
  .song-meta { margin: 0 0 var(--space-2); font-size: 0.9375rem; }
  .song-top {
    display: grid;
    gap: var(--space-3);
    align-items: end;
  }
  @media (min-width: 720px) {
    .song-top:has(.song-cover) { grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); }
  }
  .song-cover { width: 100%; aspect-ratio: 1; object-fit: cover; }
  .song-title { font-size: clamp(2rem, 6vw, 3.5rem); }
  .song-artist { margin: var(--space-1) 0 0; font-size: 1.25rem; }
  .song-score { margin: var(--space-3) 0 0; line-height: 1; }
  .score-value { font-size: clamp(3rem, 10vw, 5rem); font-weight: 700; font-variant-numeric: tabular-nums; }
  .score-max { font-size: 1.25rem; color: var(--muted); }
  .song-links { list-style: none; padding: 0; margin: var(--space-3) 0 0; display: flex; flex-wrap: wrap; gap: var(--space-1) var(--space-3); }

  .favorite {
    margin-top: var(--space-4);
    padding: var(--space-3);
    border: 1px solid var(--line);
    max-width: var(--measure);
  }
  .favorite h3 { font-size: 1.125rem; }
  .favorite p { margin: var(--space-1) 0 0; }
  .embed { margin-top: var(--space-2); aspect-ratio: 16 / 9; }
  .embed iframe { width: 100%; height: 100%; border: 0; }

  .review { margin-top: var(--space-4); max-width: var(--measure); font-size: 1.0625rem; }
  .review :global(p) { margin: 0 0 var(--space-2); }
</style>

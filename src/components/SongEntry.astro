---
import { render } from 'astro:content';
import { type Week, artistLabel, formatScore } from '../lib/weeks';
import { spotifyEmbedSrc } from '../lib/embeds';
import { SITE } from '../lib/site';

interface Props {
  entry: Week;
  headingLevel?: 'h1' | 'h2';
}
const { entry, headingLevel = 'h1' } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const hasReview = Boolean(entry.body?.trim());
const Heading = headingLevel;
const songLabel = `${d.title} by ${artistLabel(entry)}`;
const author = SITE.author;

const dateLabel = d.date
  ? d.date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' })
  : null;

const spotifySrc = d.links?.spotify ? spotifyEmbedSrc(d.links.spotify) : null;

// Services without an embedded player show as icon links that open in a new tab.
// Generic icons (not brand logos); swap in official assets here if you want.
const ICONS = {
  video: '<circle cx="12" cy="12" r="10"/><path d="M10 8.5v7l6-3.5z" fill="currentColor" stroke="none"/>',
  note: '<path d="M9 18V5l11-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="17" cy="16" r="3"/>',
  disc: '<circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="2.5"/>',
};
const iconLinks = [
  { label: 'YouTube', url: d.links?.youtube, icon: ICONS.video },
  { label: 'Apple Music', url: d.links?.apple, icon: ICONS.note },
  { label: 'Bandcamp', url: d.links?.bandcamp, icon: ICONS.disc },
].filter((l): l is { label: string; url: string; icon: string } => Boolean(l.url));
---
<article class="song">
  <header class="byline">
    {author.avatar && <img class="byline-avatar" src={author.avatar} alt="" width="48" height="48" />}
    <div>
      <p class="byline-name">
        By {author.url ? <a href={author.url} rel="author noopener">{author.name}</a> : author.name}
      </p>
      <p class="byline-meta muted">
        Week {d.week}{dateLabel && <>, <time datetime={d.date!.toISOString().slice(0, 10)}>{dateLabel}</time></>}
      </p>
    </div>
  </header>

  <div class="song-top">
    {d.cover && (
      <img class="song-cover" src={d.cover} alt={`Cover art for ${d.title}`} width="600" height="600" />
    )}
    <div class="song-id">
      <Heading class="song-title">{d.title}</Heading>
      <p class="song-artist">
        {artistLabel(entry)}
        {d.album && <span class="muted">, {d.album}{d.year && ` (${d.year})`}</span>}
      </p>

      <p class="song-score" aria-label={`Score: ${formatScore(d.score)} out of 10`}>
        <span class="score-value">{formatScore(d.score)}</span><span class="score-max">/10</span>
      </p>
    </div>
  </div>

  {(spotifySrc || iconLinks.length > 0) && (
    <div class="listen">
      {spotifySrc && (
        <iframe
          class="embed-spotify"
          src={spotifySrc}
          title={`${songLabel} on Spotify`}
          loading="lazy"
          allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
        ></iframe>
      )}

      {iconLinks.length > 0 && (
        <ul class="song-links" aria-label="Listen elsewhere">
          {iconLinks.map(({ label, url, icon }) => (
            <li>
              <a href={url} rel="noopener" target="_blank">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor"
                  stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
                  set:html={icon} />
                <span>{label}</span>
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
  )}

  {d.favorite && (
    <section class="favorite" aria-labelledby={`fav-${d.week}`}>
      <h3 id={`fav-${d.week}`}>
        Favorite part{d.favorite.timestamp && <span class="muted"> ({d.favorite.timestamp})</span>}
      </h3>
      <p>{d.favorite.note}</p>
    </section>
  )}

  {hasReview && (
    <div class="review">
      <Content />
    </div>
  )}
</article>

<style>
  .byline { display: flex; align-items: center; gap: var(--space-2); margin-bottom: var(--space-3); }
  .byline-avatar { width: 48px; height: 48px; border-radius: 50%; object-fit: cover; }
  .byline p { margin: 0; line-height: 1.35; }
  .byline-name { font-weight: 600; }
  .byline-meta { font-size: 0.9375rem; }

  .song-top { display: grid; gap: var(--space-3); align-items: end; }
  @media (min-width: 720px) {
    .song-top:has(.song-cover) { grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); }
  }
  .song-cover { width: 100%; aspect-ratio: 1; object-fit: cover; }
  .song-id { max-width: var(--measure); }
  .song-title { font-size: clamp(2rem, 6vw, 3.5rem); }
  .song-artist { margin: var(--space-1) 0 0; font-size: 1.25rem; }
  .song-score { margin: var(--space-3) 0 0; line-height: 1; }
  .score-value { font-size: clamp(3rem, 10vw, 5rem); font-weight: 700; font-variant-numeric: tabular-nums; }
  .score-max { font-size: 1.25rem; color: var(--muted); }

  .listen { margin-top: var(--space-3); max-width: var(--measure); }
  .embed-spotify { display: block; width: 100%; height: 152px; border: 0; border-radius: 12px; }
  .song-links { list-style: none; padding: 0; margin: var(--space-2) 0 0; display: flex; flex-wrap: wrap; gap: var(--space-1) var(--space-3); }
  .song-links a { display: inline-flex; align-items: center; gap: 0.375rem; text-decoration: none; padding-block: 0.25rem; }
  .song-links a:hover span { text-decoration: underline; }

  .favorite {
    margin-top: var(--space-4);
    padding: var(--space-3);
    border: 1px solid var(--line);
    max-width: var(--measure);
  }
  .favorite h3 { font-size: 1.125rem; }
  .favorite p { margin: var(--space-1) 0 0; }

  .review { margin-top: var(--space-4); max-width: var(--measure); font-size: 1.0625rem; }
  .review :global(p) { margin: 0 0 var(--space-2); }
</style>

---
import Base from '../layouts/Base.astro';
import { getWeeks, computeStats, artistsOf, artistLabel, formatScore, weekHref, hasPage } from '../lib/weeks';

const weeks = await getWeeks();
const stats = computeStats(weeks);
const mostPicked = stats.topArtists.filter((a) => a.count === stats.topArtists[0]?.count);
const legacyCount = weeks.filter((w) => !hasPage(w)).length;
const allArtists = [...new Set(weeks.flatMap(artistsOf))].sort((a, b) => a.localeCompare(b));
---
<Base title="Archive" doodles={24} description={`All ${stats.count} songs of the week, with scores.`}>
  <section aria-labelledby="archive-heading">
    <h1 id="archive-heading">Archive</h1>

    <dl class="stats">
      <div><dt>Weeks</dt><dd>{stats.count}</dd></div>
      <div><dt>Average score</dt><dd>{stats.average.toFixed(2)}</dd></div>
      <div>
        <dt>Highest</dt>
        <dd>
          {formatScore(stats.highest[0].data.score)}:{' '}
          {stats.highest.map((w, i) => (
            <>{i > 0 && ', '}{hasPage(w) ? <a href={weekHref(w.data.week)}>{w.data.title}</a> : w.data.title}</>
          ))}
        </dd>
      </div>
      {mostPicked.length > 0 && (
        <div>
          <dt>Most picked</dt>
          <dd>{mostPicked.map((a) => a.name).join(', ')} ({mostPicked[0].count} weeks each)</dd>
        </div>
      )}
    </dl>

    <div class="controls">
      <label>
        Search
        <input type="search" id="archive-search" placeholder="Song or artist" />
      </label>
      <label>
        Artist
        <select id="archive-artist">
          <option value="">All artists</option>
          {allArtists.map((a) => <option value={a}>{a}</option>)}
        </select>
      </label>
    </div>

    {legacyCount > 0 && (
      <p class="legacy-note muted">
        Weeks marked Legacy are from the original site and only have a score.
      </p>
    )}

    <div class="table-wrap">
      <table id="archive-table">
        <thead>
          <tr>
            <th scope="col" aria-sort="descending"><button type="button" data-sort="week">Week</button></th>
            <th scope="col"><button type="button" data-sort="title">Song</button></th>
            <th scope="col"><button type="button" data-sort="artist">Artist</button></th>
            <th scope="col" class="num"><button type="button" data-sort="score">Score</button></th>
          </tr>
        </thead>
        <tbody>
          {weeks.map((w) => (
            <tr
              class={hasPage(w) ? undefined : 'is-legacy'}
              data-week={w.data.week}
              data-title={w.data.title.toLowerCase()}
              data-artist={artistLabel(w).toLowerCase()}
              data-artists={JSON.stringify(artistsOf(w))}
              data-score={w.data.score}
            >
              <td>{w.data.week}</td>
              <td>
                {hasPage(w)
                  ? <a href={weekHref(w.data.week)}>{w.data.title}</a>
                  : <>{w.data.title} <span class="legacy-tag">Legacy</span></>}
              </td>
              <td>{artistLabel(w)}</td>
              <td class="num">{formatScore(w.data.score)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p id="archive-empty" class="muted" hidden>No songs match. Clear the search or pick a different artist.</p>
  </section>
</Base>

<script>
  const table = document.getElementById('archive-table') as HTMLTableElement;
  const tbody = table.tBodies[0];
  const rows = [...tbody.rows];
  const search = document.getElementById('archive-search') as HTMLInputElement;
  const artistSel = document.getElementById('archive-artist') as HTMLSelectElement;
  const empty = document.getElementById('archive-empty') as HTMLParagraphElement;

  type Key = 'week' | 'title' | 'artist' | 'score';
  let sortKey: Key = 'week';
  let dir: 1 | -1 = -1;

  function value(row: HTMLTableRowElement, key: Key): string | number {
    const v = row.dataset[key]!;
    return key === 'week' || key === 'score' ? Number(v) : v;
  }

  function apply() {
    const q = search.value.trim().toLowerCase();
    const artist = artistSel.value;
    const sorted = [...rows].sort((a, b) => {
      const va = value(a, sortKey), vb = value(b, sortKey);
      const cmp = typeof va === 'number' ? va - (vb as number) : String(va).localeCompare(String(vb));
      // Ties fall back to newest week first
      return cmp * dir || Number(b.dataset.week) - Number(a.dataset.week);
    });
    let shown = 0;
    for (const row of sorted) {
      const matchesQ = !q || row.dataset.title!.includes(q) || row.dataset.artist!.includes(q);
      const matchesArtist = !artist || (JSON.parse(row.dataset.artists!) as string[]).includes(artist);
      row.hidden = !(matchesQ && matchesArtist);
      if (!row.hidden) shown++;
    }
    tbody.replaceChildren(...sorted);
    empty.hidden = shown > 0;

    table.querySelectorAll('th').forEach((th) => {
      const key = th.querySelector('button')?.dataset.sort;
      if (key === sortKey) th.setAttribute('aria-sort', dir === 1 ? 'ascending' : 'descending');
      else th.removeAttribute('aria-sort');
    });
  }

  table.querySelectorAll<HTMLButtonElement>('th button').forEach((btn) => {
    btn.addEventListener('click', () => {
      const key = btn.dataset.sort as Key;
      if (key === sortKey) dir = dir === 1 ? -1 : 1;
      else {
        sortKey = key;
        // Numbers default to high-first, text to A–Z
        dir = key === 'week' || key === 'score' ? -1 : 1;
      }
      apply();
    });
  });
  search.addEventListener('input', apply);
  artistSel.addEventListener('change', apply);
</script>

<style>
  h1 { font-size: clamp(3rem, 10vw, 5.5rem); line-height: 0.95; }
  .stats {
    display: grid; gap: var(--space-2) var(--space-4);
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    margin: var(--space-4) 0 0;
  }
  .stats dt { color: var(--ink-soft); font-size: 0.875rem; }
  .stats dd { margin: 0; font-family: var(--font-display); font-size: 1.375rem; line-height: 1.2; }
  .stats dd a { text-decoration-thickness: 3px; }

  .controls { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-4); }
  .controls label { display: grid; gap: 0.25rem; font-size: 0.875rem; font-weight: 700; }
  .controls input, .controls select {
    padding: 0.4rem 0; min-width: 14rem;
    border: 0; border-bottom: 2px solid var(--ink); border-radius: 0; background: transparent;
  }
  .controls input:focus, .controls select:focus { outline: none; border-bottom-color: var(--blue); }

  .legacy-note { margin: var(--space-3) 0 0; font-size: 0.875rem; }

  .table-wrap { overflow-x: auto; margin-top: var(--space-3); }
  table { width: 100%; border-collapse: collapse; }
  thead th { border-bottom: 2px solid var(--ink); }
  th, td { text-align: left; padding: 0.6rem 0.75rem 0.6rem 0; }
  td { border-bottom: 1.5px dashed var(--rule); }
  th button { all: unset; cursor: pointer; font-family: var(--font-display); font-size: 0.9375rem; }
  th button:focus-visible { outline: 3px solid var(--blue); outline-offset: 2px; }
  th[aria-sort='ascending'] button::after { content: ' \2191'; font-family: var(--font-body); }
  th[aria-sort='descending'] button::after { content: ' \2193'; font-family: var(--font-body); }
  .num { text-align: right; font-variant-numeric: tabular-nums; }
  td.num { font-weight: 700; }
  td:first-child { font-variant-numeric: tabular-nums; color: var(--ink-soft); }
  tbody tr:hover td { background: rgba(0, 120, 191, 0.07); }
</style>

---
import { SITE } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}
const {
  title,
  description = 'A new song every week, with a score and my favorite moment.',
  noindex = false,
} = Astro.props;
const fullTitle = title ? `${title} | Song of the Week` : 'Song of the Week';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <a class="wordmark" href="/">Song of the Week</a>
      <nav aria-label="Main">
        <a href="/" aria-current={path === '/' ? 'page' : undefined}>This week</a>
        <a href="/archive" aria-current={path.startsWith('/archive') ? 'page' : undefined}>Archive</a>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <p>Picked and scored by {SITE.author.name}.</p>
    </footer>
  </body>
</html>

<style is:global>
  /* Structural styles only. Aesthetic pass comes later: swap the tokens below. */
  :root {
    --bg: #ffffff;
    --fg: #1a1a1a;
    --muted: #666666;
    --line: #dddddd;
    --accent: #1a1a1a;
    --font-body: system-ui, -apple-system, 'Segoe UI', sans-serif;
    --font-display: var(--font-body);

    --measure: 68ch;          /* max line length for review text */
    --page: 1040px;           /* max page width */
    --gutter: clamp(1rem, 4vw, 2rem);
    --space-1: 0.5rem;
    --space-2: 1rem;
    --space-3: 1.5rem;
    --space-4: 2.5rem;
    --space-section: clamp(3rem, 8vw, 6rem);  /* between major sections */
  }

  *, *::before, *::after { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--fg);
    font-family: var(--font-body);
    line-height: 1.6;
  }
  img { max-width: 100%; height: auto; display: block; }
  a { color: inherit; }
  :focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }

  .skip { position: absolute; left: -9999px; }
  .skip:focus { left: var(--gutter); top: var(--space-1); background: var(--bg); padding: var(--space-1); }

  .site-header, main, .site-footer {
    width: 100%;
    max-width: var(--page);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }
  .site-header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2);
    padding-block: var(--space-3);
  }
  .wordmark { font-family: var(--font-display); font-weight: 700; text-decoration: none; }
  .site-header nav { display: flex; gap: var(--space-3); }
  .site-header nav a { text-decoration: none; color: var(--muted); }
  .site-header nav a[aria-current='page'] { color: var(--fg); text-decoration: underline; text-underline-offset: 4px; }

  main > * + * { margin-top: var(--space-section); }
  .site-footer { padding-block: var(--space-section) var(--space-4); color: var(--muted); font-size: 0.875rem; }

  h1, h2, h3 { font-family: var(--font-display); line-height: 1.2; margin: 0; }
  .muted { color: var(--muted); }
  .visually-hidden {
    position: absolute; width: 1px; height: 1px; overflow: hidden;
    clip: rect(0 0 0 0); white-space: nowrap;
  }
  @media (prefers-reduced-motion: reduce) {
    * { animation: none !important; transition: none !important; scroll-behavior: auto !important; }
  }
</style>
